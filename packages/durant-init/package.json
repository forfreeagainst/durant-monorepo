{
  "name": "durant-init",
  "version": "1.0.0",
  "bin": {
    "durant-init": "lib/durant-init-cli.js"
  },
  "type": "module",
  "scripts": {
    "dev:init": "echo 888 && rm -rf dist && npm run copyfiles",
    "copyfiles": "copyfiles -a -u 1 \"src/template/**/**\" dist"
  },
  "files": [
    "dist",
    "lib"
  ],
  "buildOptions": {
    "name": "DurantInit",
    "formats": [
      "esm-bundler",
      "esm-browser",
      "cjs",
      "global"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "copyfiles": "^2.4.1"
  },
  "dependencies": {
    "@durant/durant-tool": "workspace:^",
    "commander": "^14.0.1",
    "ejs": "^3.1.10",
    "inquirer": "^12.9.6"
  }
}